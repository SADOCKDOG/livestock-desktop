if(!!PrimeFaces){PrimeFaces.locales.es={closeText:"Cerrar",prevText:"Anterior",nextText:"Siguiente",monthNames:["Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"],monthNamesShort:["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"],dayNames:["Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado"],dayNamesShort:["Dom","Lun","Mar","Mie","Jue","Vie","Sab"],dayNamesMin:["D","L","M","X","J","V","S"],weekHeader:"Semana",firstDay:1,isRTL:false,showMonthAfterYear:false,yearSuffix:"",timeOnlyTitle:"Sólo hora",timeText:"Tiempo",hourText:"Hora",minuteText:"Minuto",secondText:"Segundo",currentText:"Fecha actual",ampm:false,month:"Mes",week:"Semana",day:"Día",allDayText:"Todo el día"}}function subirFichero(a){a.preventDefault();inputFichero.jq.find("input").click()}function copiar(b){var e=$(b).parents("#tools").siblings("#contenidoTextoConsolidado")[0].contentWindow;var d=$(b).parents("#tools").siblings("#contenidoTextoConsolidado")[0].contentDocument;if(!!d){var a=d.createRange();var c=e.getSelection();c.removeAllRanges();a.selectNodeContents(d.getElementsByTagName("html")[0]);c.addRange(a);d.execCommand("copy");alert("Texto copiado en el portapapeles.")}else{alert("No se tiene acceso al texto.")}return false}function imprimirElemento(a){var c=$(a).parents("#tools").siblings("#contenidoTextoConsolidado")[0].contentDocument;if(!!c){var b=window.open("","PRINT","height=400,width=600");b.document.write(c.getElementsByTagName("html")[0].innerHTML);b.document.close();b.focus();b.print();b.onafterprint=function(){b.close()}}else{alert("No se tiene acceso al texto.")}return true}function imprimirLOG(){var a=document.getElementById("resultadoZip").innerHTML;var d=a.replace(/<br>/g,"\n");var c=document.createElement("a");var b=new Blob([d],{type:"text/plain"});c.href=URL.createObjectURL(b);c.download="LOG";c.click()}function runProgressBar(){var b=PF("pbDescomprimir");if(!!b&&0<b.getValue()&&b.getValue()<100){PF("pbDescomprimir").start()}var c=PF("pbAnalizar");if(!!c&&0<c.getValue()&&c.getValue()<100){PF("pbAnalizar").start()}var a=PF("pbImportar");if(!!a&&0<a.getValue()&&a.getValue()<100){PF("pbImportar").start()}};