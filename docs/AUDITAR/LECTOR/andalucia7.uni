		PrintText(0,19,1,"Cr.:")
		EditMaskedField(23,18,1,CROTAL)
		PrintText(0,29,1,"F.Nac:")
		EditDateField(38,28,1,BORNDATE)
		PrintText(0,39,1,"Sexo:")
		EditChoiceField(38,38,1,SEX)
		//PrintText(60,39,1,"Cebo:")
		//EditChoiceField(97,38,1,CEBO)
		DrawLine(0,50,127,50)
		IconDelete(0,52,table,0)
		//DrawRec(80,45,117,65)
		IconFindCol(18,52,EID,0)
		PrintText(40,59,0,"CAPRINO+CAMPOS b")
		PrintText(40,52,0,"CROTAL OPCIONAL")
	end_screen
	begin_screen
		PrintText(0,0,1,"Raza:")
