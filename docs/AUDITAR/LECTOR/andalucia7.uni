//*******// macro DATE TIME //***********************************

begin_macro:DATE
	begin_action_area
    	end_action_area
	begin_screen  
        		DrawLine(0,0,127,0)
		PrintText(0,20,2,"Hora:")
		SetTime(40,19,2)
		PrintText(0,35,2,"Fecha:")
		SetDate(40,34,2)
		DrawLine(0,56,127,56)
		//PrintText(0,58,0,"4.1")
	end_screen
   	begin_control_area
	end_control_area	

end_macro



//*******// macro OTROS //***********************************

begin_macro:OTROS
	begin_action_area
    	end_action_area
	begin_screen
		DrawLine(0,0,127,0)
		PrintText(0,20,2,"N. Registros:")
	   	PrintExp(77,20,2,count(*))
		DrawLine(0,56,127,56)
		//PrintText(0,58,0,"5.1")
	end_screen	
    	begin_control_area
	end_control_area	

end_macro

END


MENU
  M0:{Ovino,M1};{Caprino,M2};{Fecha/Hora,M3};{Otros,M4}
  M1:NEW_REC_CROTALO
  M2:NEW_REC_CROTALC
  M3:DATE
  M4:OTROS
END


