TABLE                                                                                                                                                                                              
  EID;R;1;1;1;000000000000;;
  CROTAL;S;0;1;1;&&&&&&&&&&&&&&&;;
  IDDATE;D;0;1;1;0000000000;;
  VET;S;0;1;1;&&&&&&&&&&;;
  FARM;S;0;1;1;ES############;;
  SPECIE;G;0;1;1;##;1;
  RAZAO;O;0;1;1;Merina,M precoz,Segur,Montes,Churra L,M Graza,Manchega,Ile de Fr,Berric,Fleich,Landsc,Charmoise,Suffolk,Romanov,Lacaune,Muflon,Awassi,Lojena,Ot Puras,Cto Mest;Merina;
  RAZAC;O;0;1;1;Bl Celt,Bl And,Neg ser,Payoya,MurGran,Malag,Florida,Saanen,AlpinaFr,Ot Puras,Cto Mest;Bl Celt;
  TID;O;0;1;0;BoloCrotal,Inyectable,CrotalElec;BoloCrotal; 
  BORNDATE;D;0;1;1;0000000000;;
  SEX;O;0;1;1;H,M;H;

END


GLOBAL
0:O
1:C
END


MESSAGE
END


MACRO

//*******// macro NEW_REC_CROTAL OVINO//***********************************


 begin_macro:NEW_REC_CROTALO
	
	 begin_action_area
		ReadNew(EID)
		Sorting(EID)
		Paste(FARM)
		Paste(VET)
		Paste(BORNDATE)
		Paste(SEX)
		Paste(TID)
		Paste(RAZAO)
		PutGlobal(SPECIE,0)
		FillExp(IDDATE,date())
	end_action_area
	begin_screen
		PrintAnimalMark(0,0,0,EID)
		PrintText(15,0,0,"DUP:")
		PrintRetagging(37,0,0,EID)
		PrintText(58,0,0,"ESP:")
		PrintUserInfo(80,0,0,EID)
		PrintReserved(110,0,0,EID)
		PrintAddInfo(122,0,0,EID)
 		PrintCountryNumber(0,5,2,EID)        
	 	PrintField(32,5,2,EID)
		DrawLine(0,16,127,16)
		
		PrintText(0,19,1,"Cr.:")
		EditMaskedField(23,18,1,CROTAL)
		PrintText(0,29,1,"F.Nac:")
		EditDateField(38,28,1,BORNDATE)
		PrintText(0,39,1,"Sexo:")
		EditChoiceField(38,38,1,SEX)
		
		DrawLine(0,50,127,50)
		IconDelete(0,52,table,0)
		IconFindCol(18,52,EID,0)
		PrintText(40,59,0,"OVINO+CAMPOS b")
		PrintText(40,52,0,"CROTAL OPCIONAL")
	end_screen
	begin_screen
		PrintText(0,0,1,"Raza:")
		EditChoiceField(30,0,1,RAZAO)
		PrintText(0,11,1,"F.Id:")
		EditDateField(30,11,1,IDDATE)
		PrintText(0,22,1,"Expl:")
		EditMaskedField(30,22,1,FARM)
		PrintText(0,33,1,"Usu:")
		EditMaskedField(30,33,1,VET)
		PrintText(0,44,1,"Tipo Id:")
		EditChoiceField(47,44,1,TID)
		
		DrawLine(0,56,127,56)
		PrintText(40,59,0,"OVINO+CAMPOS a")
	end_screen  
	begin_control_area
		Copy(table)
	end_control_area
 end_macro



//*******// macro NEW_REC_CROTAL CAPRINO //***********************************


 begin_macro:NEW_REC_CROTALC
	
	 begin_action_area
		ReadNew(EID)
		Sorting(EID)
		Paste(FARM)
		Paste(VET)
		Paste(BORNDATE)
		Paste(SEX)
		Paste(TID)
		Paste(RAZAC)
		PutGlobal(SPECIE,1)
		FillExp(IDDATE,date())
	end_action_area
	begin_screen
		PrintAnimalMark(0,0,0,EID)
		PrintText(15,0,0,"DUP:")
		PrintRetagging(37,0,0,EID)
		PrintText(58,0,0,"ESP:")
