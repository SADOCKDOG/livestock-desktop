		PrintText(0,44,1,"Tipo Id:")
		EditChoiceField(47,44,1,TID)
		
		DrawLine(0,56,127,56)
		PrintText(40,59,0,"CAPRINO+CAMPOS a")
	end_screen
	begin_control_area
		Copy(table)
	end_control_area

 end_macro

