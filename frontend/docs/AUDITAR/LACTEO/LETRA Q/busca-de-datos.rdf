				<dct:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/deed.gl"></dct:license> 
				<dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Autonomia/Galicia" /> 
				<dct:references rdf:resource="http://www.ige.eu/estatico/pdfs/s3/metodoloxias/met_ecv_2009_ga.pdf" /> 
				<dct:references rdf:resource="http://www.ige.eu/estatico/pdfs/s3/cuestionarios/cuestionario_ECV_2009_gl.pdf" /> 
