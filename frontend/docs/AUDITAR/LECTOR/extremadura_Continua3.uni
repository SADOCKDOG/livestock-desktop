	end_screen	
    	begin_control_area
	end_control_area	
end_macro

//*******// macro EXPLOTACION//***********************************

begin_macro:EXPLOTACION
	
	begin_action_area
		ReadNew(log.LEID)
		FillExp(log.FECHA,date())
		FillExp(log.HORA,time())
		Paste(log.REGA)
	end_action_area
	begin_screen
	
		PrintField(6,0,3,log.LEID)
		
		DrawLine(0,17,127,17)
		PrintText(0,20,2,"Explotacion:")
		EditMaskedField(0,32,2,log.REGA)
		DrawLine(0,50,127,50)
		PrintText(0,52,2,"Contador:")
		PrintExp(60,52,2,count(log.*))
	end_screen
	begin_control_area
		Copy(log)
	end_control_area
end_macro

//*******// macro LECTURA CONTINUA//***********************************

begin_macro:CONTINUA
	
	begin_action_area
		LoopReadNew_p(log.LEID)
		FillExp(log.FECHA,date())
		FillExp(log.HORA,time())
		Paste(log.REGA)
	end_action_area
	begin_screen
		DrawLine(0,0,127,0)
		PrintText(0,25,4,"Lectura Continua")
		PrintText(0,5,2,"Exp.:")
		PrintField(30,5,2,log.REGA)
		DrawLine(0,50,127,50)
		PrintText(0,52,2,"Contador:")
		PrintExp(60,52,2,count(log.*))
	end_screen
	begin_control_area
		Copy(log)
	end_control_area
end_macro

