//*******// macro DATE TIME //***********************************

begin_macro:DATE
	begin_action_area
    	end_action_area
	begin_screen
		DrawLine(0,0,127,0)
		PrintText(0,20,2,"Hora:")
		SetTime(40,19,2)
		PrintText(0,35,2,"Fecha:")
