MACRO

//*******// macro NEW_REC_CROTAL OVINO//***********************************

begin_macro:NEW_REC_CROTALO
	
	 begin_action_area
		ReadNew(table.EID)
		Sorting(table.EID)
		Paste(table.EXPLOT)
		Paste(table.FECHANAC)
		Paste(table.SEXO)
		Paste(table.RAZAO)
		Paste(table.TIPOID)
		FillExp(table.ESPECIE,"2")
		FillExp(table.FECHAID,date())
	end_action_area
	begin_screen
		PrintAnimalMark(0,0,0,table.EID)
		PrintText(15,0,0,"DUP:")
		PrintRetagging(37,0,0,table.EID)
		PrintText(58,0,0,"ESP:")
		PrintUserInfo(80,0,0,table.EID)
		PrintReserved(110,0,0,table.EID)
		PrintAddInfo(122,0,0,table.EID)
		PrintCountryNumber(0,5,2,table.EID)        
	 	PrintField(32,5,2,table.EID)
		DrawLine(0,16,127,16)
		PrintText(0,20,2,"F.Nac:")
		EditDateField(38,20,2,table.FECHANAC)
		PrintText(0,33,2,"Sexo:")
		EditChoiceField(38,33,2,table.SEXO)
		DrawLine(0,50,127,50)
		IconDelete(0,52,table,0)
		IconFindCol(18,52,table.EID,0)
		PrintText(40,55,0,"OVINO+CAMPOS b")
	end_screen
	begin_screen
  		DrawLine(0,0,127,0)		
		PrintText(0,1,2,"Raza:")
		EditChoiceField(35,1,2,table.RAZAO)
		PrintText(0,15,2,"F.Id:")
		EditDateField(35,15,2,table.FECHAID)
		PrintText(0,29,2,"T.Id:")
		EditChoiceField(35,29,2,table.TIPOID)
		PrintText(0,42,2,"Expl:")
		EditMaskedField(35,42,2,table.EXPLOT)
		DrawLine(0,56,127,56)
		PrintText(40,59,0,"OVINO+CAMPOS a")
	end_screen
	begin_control_area
		Copy(table)
	end_control_area
end_macro

