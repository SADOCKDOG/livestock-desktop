var CUSTOM_CHAT={initialize:false,portletID:"",portletNamespace:"",userID:"",userContactID:"",urlUpdateCountMessage:"",urlClearChatOperator:"",sound:null,soundContainer:null,addListenerPoller:function(){var a=this;a.id=a.portletID;Liferay.Poller.addListener(a.id,a.renderMessageChat,a);$("#popup-users").show();$("#popup-chat").hide()},openChatWithUser:function(){var a=this;a.updateCurrentContact("add");$("#popup-users").hide();$("#popup-chat").show()},removeListener:function(){var a=this;a.id=a.portletID;a.updateCurrentContact("remove");a.updateCountMessage();Liferay.Poller.removeListener(a.id);a.userContactID="";$("#popup-users").show();$("#popup-chat").hide();$("#buttonChatWith").hide();$(".direct-chat-messages").html("")},backListOperators:function(){var a=this;a.updateCurrentContact("remove");a.updateCountMessage();a.userContactID="";$("#popup-users").show();$("#popup-chat").hide();$("#buttonChatWith").hide();$(".direct-chat-messages").html("")},updateCurrentContact:function(c){var a=this;var b={};b.action=c;b.userContactID=a.userContactID;Liferay.Poller.submitRequest(a.id,b,null)},updateCountMessage:function(){var a=this;var b=a.userID+"VS"+a.userContactID;$.ajax({type:"GET",url:a.urlUpdateCountMessage,data:{operatorID:a.userContactID},success:function(c){$("tr#"+b).find("span.badge").text(c.result+" mensajes")}})},openChatWith:function(c){var a=this;a.userContactID=c;CUSTOM_CHAT.openChatWithUser();$(".direct-chat-messages").html("");$(".direct-chat-messages").html("<div id='boxSpinnerLoading'><i class='fa fa-spinner fa-spin fa-2x'></i><span>conectando al chat...</span></div>");$(".popup-messages-footer").hide();var b=$(".direct-chat-messages");b.scrollTop(b[0].scrollHeight)},renderMessageChat:function(d,c){var a=this;$("div#boxSpinnerLoading").remove();var e=false;$(".direct-chat-messages").find("div[data-entry-id='incoming-message']").remove();$.each(d.entries,function(l,o){var j=o.entryId;if($(".direct-chat-messages").find("div[data-entry-id='"+j+"']").length==0){var i="yo";if(o.fromFullName!=null){i=o.fromFullName}var m=o.content;var n=new Date(o.createDate);if(o.statusDate!="ALTRO"){o.messageDATE=o.statusDate}if($(".direct-chat-messages").find("abbr.timestamp[date-id='"+o.messageDATE+"']").length==0){if(o.messageDATE=="TODAY"){$(".direct-chat-messages").append("<div class='chat-box-single-line'><abbr class='timestamp' date-id='"+o.messageDATE+"'>HOY</abbr></div>")}else{if(o.messageDATE=="YESTERDAY"){$(".direct-chat-messages").append("<div class='chat-box-single-line'><abbr class='timestamp' date-id='"+o.messageDATE+"'>AYER</abbr></div>")}else{if(o.messageDATE=="ALTRO"){$(".direct-chat-messages").append("<div class='chat-box-single-line'><abbr class='timestamp' date-id='"+o.messageDATE+"'>OTROS</abbr></div>")}else{$(".direct-chat-messages").append("<div class='chat-box-single-line'><abbr class='timestamp' date-id='"+o.messageDATE+"'>"+o.messageDATE+"</abbr></div>")}}}}var f=$("<div class='message-entry' data-entry-id='"+j+"' />");var g=$("<div class='direct-chat-info clearfix'><span class='direct-chat-name pull-left'>"+i+"</span></div>");if(i!="yo"){g.find("span").addClass("direct-chat-name-right")}else{g.find("span").addClass("direct-chat-name-left")}var h=$("<div class='direct-chat-text'>"+m+"</div>");if(i!="yo"){h.addClass("direct-chat-text-right");h.css("background","#BFDDCA");h.css("color","black")}else{h.addClass("direct-chat-text-left");h.css("background","#FFFFFF")}var k=$("<div class='direct-chat-info clearfix'><span class='direct-chat-timestamp'>"+o.messageTIME+"</span></div>");if(i!="yo"){k.find("span").addClass("pull-left")}else{k.find("span").addClass("pull-right")}f.append(g).append(h).append(k);$(".direct-chat-messages").append(f);e=true}});if(e){var b=$(".popup-messages");b.scrollTop(b[0].scrollHeight);AUI().use("swfobject",function(f){a.sound=new SWFObject("/MADEVChatContact-portlet/alert.swf","alertsound","0","0","8");a.soundContainer=f.one("#boxChatPanel").one(".chat-sound");a.sound.write(a.soundContainer.getDOM())})}$(".popup-messages-footer").show();$("#buttonChatWith").show()},clearChatOperator:function(){$(".direct-chat-messages").html("<i class='fa fa-spinner fa-spin fa-5x'></i>");var a=this;$.ajax({type:"GET",url:a.urlClearChatOperator,data:{operatorID:a.userContactID},success:function(c){$(".direct-chat-messages").html("")}});var b=a.userID+"VS"+a.userContactID;$("tr#"+b).find("span.badge").text("0")},sendStaticMessage:function(){var b=this;b.id=b.portletID;var d={};d.content=$("#message").val();if(d.content.trim()!=""){d.toUserId=b.userContactID;d.action="send";Liferay.Poller.submitRequest(b.id,d,null);$("#message").val("");var c=$(".direct-chat-messages");c.append("<div data-entry-id='incoming-message'><div class='direct-chat-info clearfix'>	<span class='direct-chat-name pull-left direct-chat-name-left'>yo</span></div><div class='direct-chat-img direct-chat-img-left'><i class='fa fa-spinner fa-spin fa-2x'></i></div><div class='direct-chat-text direct-chat-text-left' style='background: rgb(255, 255, 255) none repeat scroll 0% 0%;'>"+d.content+"</div><div class='direct-chat-info clearfix'><span class='direct-chat-timestamp pull-right'>ora</span></div></div>");var a=$(".popup-messages");a.scrollTop(a[0].scrollHeight)}else{$("#message").val("")}},sendEmailChatWith:function(){alert("No disponible")}};