function adjustParametrics(){AUI().all(".parametrics").each(function(a){var b=[];a.all(".table-columns th").each(function(c){b.push(c.text().trim())});adjustParametricsCell(a,b);adjustParametricsSVG(a);adjustParametricsPaginator(a)})}function adjustParametricsCell(a,b){a.all("tbody tr").each(function(c){c.all("td").each(function(d,e){if(b[e]!==""){d.setAttribute("data-th",b[e])}})})}function adjustParametricsSVG(a){a.all(".parametrics__icon").each(function(c){var b=c.previous("span");if(!!b){c.appendTo(b.one("a"))}})}function adjustParametricsPaginator(a){a.all(".taglib-page-iterator").each(function(d){var b=d.one(".lfr-pagination-buttons li:first-child");var c=d.one(".lfr-pagination-buttons li:last-child");var e=d.one(".search-results");if(b.hasClass("disabled")){b.one("a").addClass("disabled")}if(c.hasClass("disabled")){c.one("a").addClass("disabled")}b.one("a").addClass("pagination-button pagination-button--previous").prependTo(e);c.one("a").addClass("pagination-button pagination-button--next").appendTo(e)})}AUI().later(1000,window,function(){var a=new Date();var c=a.getHours().toString().padStart(2,"0")+":"+a.getMinutes().toString().padStart(2,"0")+":"+a.getSeconds().toString().padStart(2,"0");var b=AUI().one("#banner span.time");if(!!b){b.set("text",c)}},[],true);AUI().ready("liferay-hudcrumbs","liferay-navigation-interaction","liferay-sign-in-modal",function(b){var a=b.one("#navigation");if(!!a){a.plug(Liferay.NavigationInteraction);var e=a.one("a.btn-navbar");if(!!e){e.on("click",function(){a.toggleClass("open");b.all(".nav-collapse").toggleClass("open")})}}var d=b.one("#breadcrumbs");if(d){d.plug(b.Hudcrumbs)}var c=b.one("li.sign-in a");if(c&&c.getData("redirect")!=="true"){c.plug(Liferay.SignInModal)}if(b.all(".parametrics").size()>0){adjustParametrics()}});