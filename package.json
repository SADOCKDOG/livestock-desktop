{
  "name": "livestock-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Livestock Manager PREMIUM - app de escritorio nativa (Tauri) para gestion ganadera.",
  "scripts": {
    "serve": "npx --yes http-server frontend -p 8089 -c-1",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "sync": "pwsh scripts/sync-from-master.ps1",
    "test:e2e": "cypress run --spec cypress/integration/gastos-column-selector.spec.js",
    "prebuild:pago": "pwsh -Command \"Copy-Item frontend/js/mode-config-con-pago.js frontend/js/mode-config.js -Force\"",
    "prebuild:demo": "pwsh -Command \"Copy-Item frontend/js/mode-config-sin-pago.js frontend/js/mode-config.js -Force\"",
    "build:pago": "npm run prebuild:pago && tauri build",
    "build:demo": "npm run prebuild:demo && tauri build",
    "build:free": "npm run build:pago",
    "build:premium": "npm run build:demo",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "@tauri-apps/api": "latest",
    "@tauri-apps/cli": "latest",
    "cypress": "13.17.0",
    "wrangler": "^4.127.1"
  }
}
